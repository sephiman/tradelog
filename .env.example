# Externally-managed Postgres on a shared Docker network.
# The backend joins this network and resolves Postgres by DNS alias = DB_HOST.
SHARED_NETWORK_NAME=all_dockers

# Host port published for the frontend.
FRONTEND_PORT=8088

# Host interface to bind the published port on (0.0.0.0 reachable, 127.0.0.1 loopback only).
FRONTEND_BIND_ADDR=0.0.0.0

# Database — the operator must create this DB and user in Postgres before first run.
DB_HOST=postgresdb
DB_PORT=5432
DB_NAME=tradelog
DB_USERNAME=tradelog
DB_PASSWORD=change-me

# Cookie security. Set to false ONLY for local plain-HTTP development.
APP_COOKIE_SECURE=true

# Public frontend origin of this deployment, no trailing slash (https://tradelog.example.com).
# Mailed links are built from it and never from request headers.
APP_PUBLIC_URL=

# Registration policy: open | invite-only | closed.
REGISTRATION_MODE=open

# First-run admin bootstrap. Required if no users exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Base64 AES key (16/24/32 bytes) encrypting exchange API credentials at rest.
# Generate one with: openssl rand -base64 32 — keep it stable, rotating makes
# stored credentials undecryptable.
TRADELOG_CRYPTO_KEY=

# JVM tuning (optional).
# SPRING_PROFILES_ACTIVE=prod
# JAVA_OPTS=

# Outbound email (optional, as a GROUP). Drives the self-service password reset and the
# verified half of the email change. With none of these set the login page shows no
# "Forgot your password?" link and the reset endpoints answer 404. A partial group keeps
# the features hidden too and logs one startup warning naming the missing variables.
# APP_PUBLIC_URL above is part of the group.
#   Gmail: 2-Step Verification + an App Password (SMTP_PASSWORD is the App Password),
#   SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_STARTTLS=true, MAIL_FROM = the
#   authenticated address (or a verified "Send mail as" alias).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# MAIL_FROM=

# AI trading-style analysis (optional, as a GROUP). Any OpenAI-compatible chat-completions
# API. Without AI_API_KEY the feature does not exist: /api/features reports ai=false,
# every AI endpoint answers 404 and the dashboard renders nothing. A partial group keeps
# it hidden too and logs one startup warning naming the missing variables. Even with a
# key, each user still turns it on in Settings. Only the dashboard's aggregate numbers
# (with sample sizes) are sent — never credentials, identifiers, notes, profile names or
# individual trades; Origen tag names are anonymized in the browser.
# AI_API_KEY=
# AI_BASE_URL=https://opencode.ai/zen/go/v1
# AI_MODEL=deepseek-v4.1-flash
# AI_TIMEOUT_MS=120000

# Sync sweeps (optional tuning).
#   SYNC_RATE_PER_MINUTE: sync RUNS per exchange per minute.
#   SYNC_OVERLAP_DAYS: incremental syncs re-scan this many days before the close watermark.
#   SYNC_SCHEDULE_*: the daily background sweep of every ACTIVE API source.
# SYNC_RATE_PER_MINUTE=30
# SYNC_OVERLAP_DAYS=30
# SYNC_SCHEDULE_ENABLED=true
# SYNC_SCHEDULE_CRON=0 0 4 * * *
# SYNC_SCHEDULE_SPACING_MS=3000

# Capital snapshots (optional tuning): the hourly job materializing AUTO snapshots on each
# profile's cadence days; idempotent, so a re-run costs nothing.
# CAPITAL_SNAPSHOT_ENABLED=true
# CAPITAL_SNAPSHOT_CRON=0 20 * * * *

# Benchmarks (optional tuning): keyless public market data behind the Monthly ROI and
# capital-evolution comparison lines. No user data leaves the instance.
# BENCHMARK_SCHEDULE_ENABLED=true
# BENCHMARK_SCHEDULE_CRON=0 30 3 * * *
# BENCHMARK_BACKFILL_ON_START=true
# BENCHMARK_HISTORY_LOOKBACK_DAYS=3650

# Per-exchange API base URLs and timeouts (optional; defaults are correct for every venue).
# BITUNIX_BASE_URL= / BITUNIX_TIMEOUT_MS=10000
# BINGX_BASE_URL= / BINGX_TIMEOUT_MS=10000
# BITMART_BASE_URL= / BITMART_TIMEOUT_MS=10000
# BINANCE_BASE_URL= / BINANCE_TIMEOUT_MS=10000
# BYBIT_BASE_URL= / BYBIT_TIMEOUT_MS=10000
# OKX_BASE_URL= / OKX_TIMEOUT_MS=10000
# BITGET_BASE_URL= / BITGET_TIMEOUT_MS=10000
# KRAKEN_FUTURES_BASE_URL= / KRAKEN_FUTURES_TIMEOUT_MS=10000
# KRAKEN_SPOT_BASE_URL= / KRAKEN_SPOT_TIMEOUT_MS=10000
# GATEIO_BASE_URL= / GATEIO_TIMEOUT_MS=10000
# MEXC_BASE_URL= / MEXC_TIMEOUT_MS=10000
# KUCOIN_FUTURES_BASE_URL= / KUCOIN_FUTURES_TIMEOUT_MS=10000
# TOOBIT_BASE_URL= / TOOBIT_TIMEOUT_MS=10000
